{
	"name": "pr5auth",
	"version": "1.0.0",
	"type": "module",
	"description": "PR5Auth — offline-first desktop TOTP authenticator",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test",
		"build:release": "vite build && electrobun build --env=stable",
		"build:canary": "vite build && electrobun build --env=canary",
		"test": "bun test"
	},
	"dependencies": {
		"@noble/hashes": "^2.3.0",
		"electrobun": "1.18.1",
		"jsqr": "^1.4.0",
		"lucide-react": "^1.32.0",
		"otplib": "^13.4.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.0.0",
		"@types/bun": "latest",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "5",
		"concurrently": "^9.1.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	},
	"packageManager": "bun@1.4.0"
}
